// 分析页:今日 / 周 / 月。周与月的日历强度直接画在页面里,没有独立的热力图页。

import { Theme, CategoryRow, DonutSlice, RangeCell, TimelineRow } from "types.slint";

component PeriodChip inherits Rectangle {
    in property <int> index;
    in property <string> label;
    in property <bool> active;
    callback picked();

    height: 28px;
    width: chip-text.preferred-width + 22px;
    border-radius: 14px;
    background: root.active ? Theme.ink : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.ink : Theme.line;

    chip-text := Text {
        text: root.label;
        color: root.active ? #ffffff : Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.picked(); }
    }
}

component DayCell inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <color> fill;
    in property <color> ink;

    background: root.fill;
    border-radius: 8px;

    VerticalLayout {
        alignment: center;
        spacing: 0px;
        Text {
            text: root.label;
            color: root.ink;
            font-size: 11px;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            color: root.ink;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}

export component StatsPage inherits Rectangle {
    background: transparent;

    in-out property <int> period: 0;
    in property <string> range-label: "";
    in property <string> total-text: "0分";
    in property <string> study-text: "0分";
    in property <int> study-percent: 0;
    in property <string> range-note: "";
    in property <[DonutSlice]> slices: [];
    in property <[CategoryRow]> categories: [];
    in property <[TimelineRow]> entries: [];
    in property <[RangeCell]> week-cells: [];
    in property <[[RangeCell]]> month-rows: [];

    callback set-period(int);
    callback shift(int);

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;
            PeriodChip { index: 0; label: "今日"; active: root.period == 0; picked => { root.set-period(0); } }
            PeriodChip { index: 1; label: "周"; active: root.period == 1; picked => { root.set-period(1); } }
            PeriodChip { index: 2; label: "月"; active: root.period == 2; picked => { root.set-period(2); } }
        }

        HorizontalLayout {
            spacing: 6px;
            height: 22px;

            Rectangle {
                width: 20px;
                background: transparent;
                Text { text: "‹"; color: Theme.muted; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.shift(-1); } }
            }
            Text {
                text: root.range-label;
                color: Theme.ink-2;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 20px;
                background: transparent;
                Text { text: "›"; color: Theme.muted; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.shift(1); } }
            }
        }

        // 环形图 + 摘要
        HorizontalLayout {
            spacing: 12px;
            height: 128px;
            alignment: center;

            if root.slices.length > 0 : Rectangle {
                width: 128px;
                height: 128px;
                background: transparent;
                for slice in root.slices : Path {
                    commands: slice.path;
                    fill: slice.color;
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 4px;

                Text {
                    text: "全部 " + root.total-text;
                    color: Theme.ink;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: "学习+工作 " + root.study-text + " · 占 " + root.study-percent + "%";
                    color: Theme.ink-2;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.range-note;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // 周:一排七格
        if root.period == 1 : VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 4px;
                for cell in root.week-cells : VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: cell.label;
                        color: Theme.muted;
                        font-size: 10px;
                        horizontal-alignment: center;
                    }
                    DayCell {
                        height: 44px;
                        label: cell.hint;
                        hint: "";
                        fill: cell.color;
                        ink: cell.text-color;
                    }
                }
            }
        }

        // 月:按周对齐的日历
        if root.period == 2 : VerticalLayout {
            spacing: 3px;

            HorizontalLayout {
                spacing: 3px;
                for name in ["一", "二", "三", "四", "五", "六", "日"] : Text {
                    text: name;
                    color: Theme.muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            for row in root.month-rows : HorizontalLayout {
                spacing: 3px;
                for cell in row : DayCell {
                    horizontal-stretch: 1;
                    height: 34px;
                    label: cell.label;
                    hint: cell.hint;
                    fill: cell.color;
                    ink: cell.text-color;
                }
            }
        }

        if root.entries.length > 0 : VerticalLayout {
            spacing: 2px;
            for row in root.entries : HorizontalLayout {
                spacing: 8px;
                height: 22px;

                Rectangle { width: 3px; border-radius: 2px; background: row.color; }
                Text {
                    text: row.label;
                    color: Theme.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text { text: row.time; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Text { text: row.duration; color: Theme.ink-2; font-size: 12px; vertical-alignment: center; width: 62px; horizontal-alignment: right; }
            }
        }

        if root.categories.length > 0 : VerticalLayout {
            spacing: 2px;
            for row in root.categories : HorizontalLayout {
                spacing: 8px;
                height: 22px;

                Rectangle { width: 3px; border-radius: 2px; background: row.color; }
                Text {
                    text: row.label;
                    color: Theme.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text { text: row.percent; color: Theme.muted; font-size: 11px; vertical-alignment: center; width: 38px; horizontal-alignment: right; }
                Text { text: row.amount; color: Theme.ink-2; font-size: 12px; vertical-alignment: center; width: 62px; horizontal-alignment: right; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
