// 分析页:今日 / 周 / 月 / 热力图。环形图路径由 Rust 算好,这里只画。

import { Theme, CategoryRow, DonutSlice, HeatCell, TimelineRow } from "types.slint";

component PeriodChip inherits Rectangle {
    in property <int> index;
    in property <string> label;
    in property <bool> active;
    callback picked();

    height: 28px;
    width: chip-text.preferred-width + 22px;
    border-radius: 14px;
    background: root.active ? Theme.ink : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.ink : Theme.line;

    chip-text := Text {
        text: root.label;
        color: root.active ? #ffffff : Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.picked(); }
    }
}

export component StatsPage inherits Rectangle {
    background: transparent;

    in-out property <int> period: 0;
    in property <string> range-label: "";
    in property <string> total-text: "0分";
    in property <string> study-text: "0分";
    in property <int> study-percent: 0;
    in property <[DonutSlice]> slices: [];
    in property <[CategoryRow]> categories: [];
    in property <[TimelineRow]> entries: [];
    in property <[[HeatCell]]> heat-weeks: [];
    in property <string> heat-stats: "";

    callback set-period(int);
    callback shift(int);

    VerticalLayout {
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            PeriodChip { index: 0; label: "今日"; active: root.period == 0; picked => { root.set-period(0); } }
            PeriodChip { index: 1; label: "周"; active: root.period == 1; picked => { root.set-period(1); } }
            PeriodChip { index: 2; label: "月"; active: root.period == 2; picked => { root.set-period(2); } }
            PeriodChip { index: 3; label: "热力图"; active: root.period == 3; picked => { root.set-period(3); } }
        }

        if root.period != 3 : HorizontalLayout {
            spacing: 6px;
            height: 24px;

            Rectangle {
                width: 22px;
                background: transparent;
                Text { text: "‹"; color: Theme.muted; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.shift(-1); } }
            }
            Text {
                text: root.range-label;
                color: Theme.ink-2;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 22px;
                background: transparent;
                Text { text: "›"; color: Theme.muted; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.shift(1); } }
            }
        }

        if root.period == 3 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;
            alignment: start;

            Text {
                text: root.heat-stats;
                color: Theme.ink-2;
                font-size: 12px;
            }

            HorizontalLayout {
                spacing: 1px;
                for week in root.heat-weeks : VerticalLayout {
                    spacing: 1px;
                    for cell in week : Rectangle {
                        width: 5px;
                        height: 5px;
                        border-radius: 1px;
                        background: cell.color;
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Text { text: "少"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: #eeece4; }
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: #cfe3d4; }
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: #9fc9a8; }
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: #66a677; }
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: #2f7a45; }
                Text { text: "多"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            }
        }

        if root.period != 3 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            if root.slices.length == 0 : Text {
                text: "这段时间还没有记录";
                color: Theme.muted;
                font-size: 13px;
            }

            HorizontalLayout {
                alignment: center;
                if root.slices.length > 0 : Rectangle {
                    width: 168px;
                    height: 168px;
                    background: transparent;
                    for slice in root.slices : Path {
                        commands: slice.path;
                        fill: slice.color;
                    }
                }
            }

            Text {
                text: "全部 " + root.total-text + "  ·  学习+工作 " + root.study-text + "  ·  占 " + root.study-percent + "%";
                color: Theme.ink-2;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            for row in root.entries : HorizontalLayout {
                spacing: 8px;
                height: 24px;

                Rectangle { width: 3px; border-radius: 2px; background: row.color; }
                Text {
                    text: row.label;
                    color: Theme.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text { text: row.time; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Text { text: row.duration; color: Theme.ink-2; font-size: 12px; vertical-alignment: center; width: 64px; horizontal-alignment: right; }
            }

            for row in root.categories : HorizontalLayout {
                spacing: 8px;
                height: 24px;

                Rectangle { width: 3px; border-radius: 2px; background: row.color; }
                Text {
                    text: row.label;
                    color: Theme.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text { text: row.percent; color: Theme.muted; font-size: 11px; vertical-alignment: center; width: 40px; horizontal-alignment: right; }
                Text { text: row.amount; color: Theme.ink-2; font-size: 12px; vertical-alignment: center; width: 64px; horizontal-alignment: right; }
            }
        }
    }
}
